@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Login";
}

<style>
    .login-wrapper {
        width: 100%;
        max-width: 430px;
        margin: 0 auto;
        animation: fadeUp 0.45s ease both;
    }
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(22px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .login-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 36px 32px;
        box-shadow: 0 20px 60px rgba(13,34,99,0.13), 0 4px 16px rgba(0,0,0,0.06);
    }

    .card-header-block {
        text-align: center;
        margin-bottom: 28px;
    }

    .card-icon {
        width: 56px;
        height: 56px;
        background: linear-gradient(135deg, #0d2263, #1e3a9f);
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
        margin-bottom: 14px;
        box-shadow: 0 6px 18px rgba(13,34,99,0.25);
    }

    .card-header-block h4 {
        font-weight: 700;
        color: #0d2263;
        font-size: 1.25rem;
        margin-bottom: 4px;
    }

    .card-header-block p {
        color: #8892aa;
        font-size: 0.82rem;
    }

    .role-toggle {
        display: flex;
        background: #eef2f9;
        border-radius: 12px;
        padding: 5px;
        margin-bottom: 26px;
        gap: 4px;
    }

    .role-btn {
        flex: 1;
        border: none;
        background: transparent;
        padding: 10px 8px;
        font-weight: 600;
        font-size: 0.83rem;
        border-radius: 9px;
        transition: all 0.22s ease;
        color: #6b7a9e;
        cursor: pointer;
    }

        .role-btn.active {
            background: #0d2263;
            color: #ffffff;
            box-shadow: 0 4px 14px rgba(13,34,99,0.28);
        }

    .field-label {
        font-weight: 600;
        font-size: 0.8rem;
        color: #3a4568;
        margin-bottom: 6px;
        display: block;
    }

    .input-wrap {
        position: relative;
        margin-bottom: 18px;
    }

    .input-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #8892aa;
        font-size: 0.95rem;
        pointer-events: none;
    }

    .field-input {
        width: 100%;
        padding: 11px 14px 11px 38px;
        border: 1.5px solid #dde3f5;
        border-radius: 10px;
        font-size: 0.875rem;
        color: #1a2340;
        background: #f8faff;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .field-input:focus {
            border-color: #0d2263;
            box-shadow: 0 0 0 3px rgba(13,34,99,0.09);
            background: #fff;
        }

        .field-input::placeholder {
            color: #b0bada;
        }

    .toggle-pass {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #8892aa;
        cursor: pointer;
        font-size: 0.95rem;
        background: none;
        border: none;
        padding: 0;
    }

        .toggle-pass:hover {
            color: #0d2263;
        }

    .error-box {
        background: #fff5f5;
        border: 1px solid #ffc9c9;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.8rem;
        color: #c8102e;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .btn-login {
        width: 100%;
        padding: 13px;
        background: linear-gradient(135deg, #0d2263, #1e3a9f);
        border: none;
        border-radius: 10px;
        color: white;
        font-weight: 700;
        font-size: 0.88rem;
        letter-spacing: 0.06em;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        margin-top: 6px;
    }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(13,34,99,0.3);
            color: white;
        }

        .footer-text {
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: var(--text-muted);
        }


    </style>

<div class="login-wrapper">
    <div class="login-card">

        <div class="card-header-block">
            <div class="card-icon"><i class="bi bi-shield-lock-fill"></i></div>
            <h4>Sign In to Portal</h4>
            <p>Enter your ERP credentials to continue</p>
        </div>

        <form asp-action="Login" method="post">

            <div class="role-toggle">
                <button type="button" class="role-btn active" onclick="setRole(1, this)">
                    <i class="bi bi-mortarboard me-1"></i> Student
                </button>
                <button type="button" class="role-btn" onclick="setRole(2, this)">
                    <i class="bi bi-person-badge me-1"></i> Coordinator
                </button>
                <input type="hidden" name="userRole" id="userRole" value="1" />
            </div>

            <label class="field-label">ERP ID</label>
            <div class="input-wrap">
                <i class="bi bi-person input-icon"></i>
                <input name="erpId" class="field-input" placeholder="e.g. STU001 or CC001" required />
            </div>

            <label class="field-label">Password</label>
            <div class="input-wrap">
                <i class="bi bi-lock input-icon"></i>
                <input name="password" type="password" id="passField" class="field-input" placeholder="••••••••" required />
                <button type="button" class="toggle-pass" onclick="togglePass()">
                    <i class="bi bi-eye" id="eyeIcon"></i>
                </button>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="error-box">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    @ViewBag.Error
                </div>
            }

            <button type="submit" class="btn-login">
                <i class="bi bi-box-arrow-in-right me-2"></i> LOGIN TO PORTAL
            </button>

        </form>

        <div class="card-footer-note">
            © 2026 BVICAM ERP System · Bharati Vidyapeeth (Deemed University)
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function setRole(role, btn) {
            document.getElementById('userRole').value = role;
            document.querySelectorAll('.role-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
        function togglePass() {
            const f = document.getElementById('passField');
            const e = document.getElementById('eyeIcon');
            if (f.type === 'password') {
                f.type = 'text';
                e.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                f.type = 'password';
                e.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }
    </script>
}
